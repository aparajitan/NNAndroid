<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_marginTop="@dimen/_10sdp"
    android:layout_marginRight="@dimen/_20sdp"
    android:layout_marginLeft="@dimen/_20sdp"
    android:layout_height="wrap_content">
    <FrameLayout
        android:orientation="vertical"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/round_corner_dialog"
        android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/_5sdp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:orientation="vertical"
                android:background="@drawable/round_corner_dialog"
                android:layout_width="match_parent"
                android:layout_marginBottom="@dimen/_12sdp"
                android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_medium"
                        android:id="@+id/referMsgShow"
                        android:text="Please confirm that the address"
                        android:textColor="@color/dialog_heading_top"
                        android:textSize="@dimen/dialog_text_size" />

            </FrameLayout>
            <TextView
                android:background="@color/line_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/post_frm"
                    android:layout_marginBottom="1dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tvOk"
                        android:layout_width="wrap_content"
                        android:text="OK"
                        android:layout_gravity="center"
                        android:gravity="start"
                        android:textColor="@color/them_color"
                        android:textSize="@dimen/_14ssp"
                        android:fontFamily="@font/montserrat_medium"
                        android:layout_height="wrap_content"/>
                </FrameLayout>


            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>